# 小皮（phpStudy）MySQL 常见本地配置，请按面板内实际端口和 root 密码调整
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=spring_workbench
PORT=3001

# ===== 识别模块 =====
# Umi-OCR 本地服务地址（离线识别引擎）
UMI_OCR_BASE=http://127.0.0.1:1224
# 工作台启动时自动拉起识别引擎：1 开（默认）/ 0 关
UMI_OCR_AUTOSTART=1
# 引擎可执行文件完整路径；留空则自动在 项目/tools/、项目根、桌面 下查找 Umi-OCR.exe
UMI_OCR_EXE=
# 大模型结构化（OpenAI 兼容）；三项任一为空即视为未配置，识别流程自动降级为「仅存识别原文」
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
